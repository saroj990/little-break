{
  "manifest_version": 3,
  "name": "AdPause",
  "version": "0.1.0",
  "description": "Covers a Prime Video, Hotstar, or Sony LIV advertisement with a short information card and mutes it until the ad ends. Does not skip ads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AdPause",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": [
    "https://en.wikipedia.org/*",
    "https://*.wikipedia.org/*",
    "https://*.wikimedia.org/*",
    "https://feeds.bbci.co.uk/*",
    "https://ichef.bbci.co.uk/*",
    "https://*.bbci.co.uk/*",
    "https://*.bbc.co.uk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.in/gp/video/*",
        "https://www.amazon.ca/gp/video/*",
        "https://www.amazon.com.au/gp/video/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.hotstar.com/*",
        "https://hotstar.com/*",
        "https://*.hotstar.com/*",
        "https://www.jiohotstar.com/*",
        "https://jiohotstar.com/*",
        "https://*.jiohotstar.com/*",
        "https://www.sonyliv.com/*",
        "https://sonyliv.com/*",
        "https://*.sonyliv.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
